            AtividadeForm["AtividadeForm<br/>+ txtCodigo: TextBox<br/>+ txtNome: TextBox<br/>+ cmbProjeto: ComboBox<br/>+ cmbResponsavel: ComboBox<br/>+ pnlErrors: Panel<br/>+ SalvarAtividade(): Task<br/>+ ExibirErros(List<ErrorDTO>): void<br/>+ ExibirAlertas(List<WarningDTO>): void<br/>+ ValidarCampos(): NotificationResult"]
            
            RelatorioForm["RelatorioForm<br/>+ dgvProjetos: DataGridView<br/>+ filtros: Panel<br/>+ btnGerarGantt: Button<br/>+ btnExportar: Button<br/>+ pnlErrors: Panel<br/>+ ExibirErros(List<ErrorDTO>): void<br/>+ ExibirAlertas(List<WarningDTO>): void"]
            
            UsuarioForm["UsuarioForm<br/>+ txtNome: TextBox<br/>+ txtEmail: TextBox<br/>+ cmbTipo: ComboBox<br/>+ cmbStatus: ComboBox<br/>+ pnlErrors: Panel<br/>+ SalvarUsuario(): Task<br/>+ ExibirErros(List<ErrorDTO>): void<br/>+ ExibirAlertas(List<WarningDTO>): void"]
        end
        
        subgraph "Core Services - MVP 1"
            ApiService["ApiService<br/>+ GetAsync<T>(string): Task<ApiResponse<T>><br/>+ PostAsync<T>(string, object): Task<ApiResponse<T>><br/>+ PutAsync<T>(string, object): Task<ApiResponse<T>><br/>+ DeleteAsync(string): Task<ApiResponse<bool>><br/>+ ProcessResponse<T>(ApiResponse<T>): Result<T>"]
        end
        
        subgraph "🔍 Observability Forms - MVP 2"
            DashboardForm["DashboardForm<br/>+ chartMetrics: Chart<br/>+ lblSystemStatus: Label<br/>+ dgvAlerts: DataGridView<br/>+ lblPerformance: Label<br/>+ UpdateMetrics(): Task<br/>+ RefreshDashboard(): Task<br/>+ ShowAlert(AlertRule): void"]
            
            LogViewerForm["LogViewerForm<br/>+ dgvLogs: DataGridView<br/>+ txtSearch: TextBox<br/>+ cmbLevel: ComboBox<br/>+ dtpFrom: DateTimePicker<br/>+ dtpTo: DateTimePicker<br/>+ btnSearch: Button<br/>+ LoadLogs(): Task<br/>+ FilterLogs(): void<br/>+ ExportLogs(): Task"]
            
            AuditTrailForm["AuditTrailForm<br/>+ dgvAudit: DataGridView<br/>+ txtUserId: TextBox<br/>+ txtEntityType: TextBox<br/>+ dtpFrom: DateTimePicker<br/>+ dtpTo: DateTimePicker<br/>+ btnSearch: Button<br/>+ LoadAuditTrail(): Task<br/>+ ShowDetails(AuditEntry): void<br/>+ ExportAudit(): Task"]
        end
        
        subgraph "🔍 Observability Services - MVP 2"
            FormService["FormService<br/>- NotificationService: NotificationService<br/>+ ExibirNotificacoes(Form, NotificationResult): void<br/>+ ExibirErros(Form, List<e>): void<br/>+ ExibirAvisos(Form, List<Warning>): void<br/>+ ExibirSucessos(Form, List<Success>): void<br/>+ GetOrCreateErrorPanel(Form): Panel<br/>+ GetOrCreateWarningPanel(Form): Panel<br/>+ GetOrCreateSuccessPanel(Form): Panel<br/>+ LimparNotificacoes(Form): void"]
            
            NotificationService["NotificationService<br/>+ ExibirErro(string, string): void<br/>+ ExibirAlerta(string, string): void<br/>+ ExibirSucesso(string, string): void<br/>+ ExibirNotificacoes(NotificationResult): void"]
            
            WinFormsMetricsService["WinFormsMetricsService<br/>- ApiService: ApiService<br/>- MetricsTimer: Timer<br/>- LocalMetrics: List<ClientMetric><br/>- Lock: object<br/>+ RecordFormOpen(string): void<br/>+ RecordFormClose(string, TimeSpan): void<br/>+ RecordUserAction(string, string): void<br/>- SendMetricsAsync(object, ElapsedEventArgs): void<br/>+ Dispose(): void"]
            
            WinFormsLogger["WinFormsLogger<br/>- LogFile: string<br/>- MaxFileSize: long<br/>+ LogInfo(string): void<br/>+ LogWarning(string): void<br/>+ LogError(string, Exception): void<br/>+ LogUserAction(string, string): void<br/>- WriteToFile(string, LogLevel): void<br/>- RotateLogFile(): void"]
        end
        
        subgraph "🔍 WinForms Extensions - MVP 2"
            FormExtensions["FormExtensions<br/>+ WithInstrumentation(Form, WinFormsMetricsService): Form<br/>+ WithNotificationHandling(Form, FormService): Form<br/>+ WithValidation(Form): Form"]
            
            ControlExtensions["ControlExtensions<br/>+ AddValidationRule(Control, Func<bool>, string): void<br/>+ ValidateAll(Form): NotificationResult<br/>+ HighlightError(Control): void<br/>+ ClearHighlight(Control): void"]
        end
    end
    
    %% Relacionamentos MVP 1
    Usuario --> NotificationResult
    Projeto --> NotificationResult
    Atividade --> NotificationResult
    
    CodigoProjeto --> Result
    CodigoAtividade --> Result
    PeriodoProjeto --> Result
    
    UsuarioUseCases --> Result
    ProjetoUseCases --> Result
    AtividadeUseCases --> Result
    RelatorioUseCases --> Result
    
    IUsuarioRepository --> Result
    IProjetoRepository --> Result
    IAtividadeRepository --> Result
    
    AuthController --> ApiResponse
    UsuarioController --> ApiResponse
    ProjetoController --> ApiResponse
    AtividadeController --> ApiResponse
    RelatorioController --> ApiResponse
    
    LoginForm --> ApiService
    ProjetoForm --> ApiService
    AtividadeForm --> ApiService
    RelatorioForm --> ApiService
    UsuarioForm --> ApiService
    
    %% Relacionamentos MVP 2 - Observabilidade
    LoggableResult --> IAppLogger
    LoggableNotificationResult --> IAppLogger
    
    AppLogger --> IAppLogger
    SerializationService --> ISerializationService
    MetricsService --> IMetricsService
    AuditService --> IAuditService
    
    InstrumentationMiddleware --> IMetricsService
    InstrumentationMiddleware --> IAppLogger
    InstrumentationMiddleware --> IAuditService
    
    MetricsController --> IMetricsService
    HealthController --> HealthCheckService
    AuditController --> IAuditService
    
    FormService --> NotificationService
    WinFormsMetricsService --> ApiService
    DashboardForm --> ApiService
    LogViewerForm --> ApiService
    AuditTrailForm --> ApiService
    
    %% Relacionamentos entre MVPs
    ProjetoUseCases -.-> IAppLogger
    ProjetoUseCases -.-> IMetricsService
    ProjetoUseCases -.-> IAuditService
    
    ProjetoRepository -.-> IAppLogger
    ProjetoRepository -.-> IMetricsService
    
    ProjetoForm -.-> FormService
    ProjetoForm -.-> WinFormsMetricsService
    
    %% Estilos
    classDef mvp1Core fill:#e1f5fe,stroke:#01579b,stroke-width:3px
    classDef mvp1Application fill:#f3e5f5,stroke:#4a148c,stroke-width:3px
    classDef mvp1Infrastructure fill:#e8f5e8,stroke:#1b5e20,stroke-width:3px
    classDef mvp1Api fill:#fff3e0,stroke:#e65100,stroke-width:3px
    classDef mvp1WinForms fill:#fce4ec,stroke:#880e4f,stroke-width:3px
    
    classDef mvp2Observability fill:#fff9c4,stroke:#f57f17,stroke-width:3px
    classDef mvp2Enhanced fill:#f1f8e9,stroke:#33691e,stroke-width:3px
    classDef mvp2Monitoring fill:#fff3e0,stroke:#bf360c,stroke-width:3px
    
    classDef patternClass fill:#fff9c4,stroke:#f57f17,stroke-width:4px
    
    %% MVP 1 - Core Classes
    class Usuario,Projeto,Atividade,CodigoProjeto,CodigoAtividade,PeriodoProjeto,ProjetoService,UsuarioService,IUsuarioRepository,IProjetoRepository,IAtividadeRepository,ErrorCodes,ErrorMessages mvp1Core
    class UsuarioUseCases,ProjetoUseCases,AtividadeUseCases,RelatorioUseCases,UsuarioDTO,ProjetoDTO,AtividadeDTO,AuthService,EmailService,RelatorioService,ValidationService,ApiResponse mvp1Application
    class AppDbContext,UsuarioRepository,ProjetoRepository,AtividadeRepository,EmailProvider,FileService,JwtService,EncryptionService mvp1Infrastructure
    class AuthController,UsuarioController,ProjetoController,AtividadeController,RelatorioController,AuthMiddleware,ExceptionMiddleware,AuthorizeFilter,ValidationFilter mvp1Api
    class LoginForm,MainForm,ProjetoForm,AtividadeForm,RelatorioForm,UsuarioForm,ApiService mvp1WinForms
    
    %% MVP 2 - Observabilidade
    class AuditEntry,LogEntry,MetricEntry,SerializationOptions,AlertRule,ClientMetric,LoggableResult,LoggableNotificationResult mvp2Observability
    class IAppLogger,ISerializationService,IMetricsService,IAuditService,ErrorDTO,WarningDTO,SuccessDTO,DashboardDataDTO,HealthCheckResultDTO,UseCaseExtensions mvp2Enhanced
    class AppLogger,SerializationService,MetricsService,PrometheusMetricsCollector,AuditService,HealthCheckService,DashboardService,SystemMonitor,ServiceRegistration mvp2Monitoring
    class MetricsController,HealthController,AuditController,InstrumentationMiddleware,NotificationMiddleware,ApplicationBuilderExtensions,ServiceCollectionExtensions mvp2Monitoring
    class DashboardForm,LogViewerForm,AuditTrailForm,FormService,NotificationService,WinFormsMetricsService,WinFormsLogger,FormExtensions,ControlExtensions mvp2Enhanced
    
    %% Patterns
    class NotificationResult,Error,Warning,Success,Result,ResultList patternClass