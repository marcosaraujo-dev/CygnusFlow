            LoginForm["LoginForm<br/>+ txtEmail<br/>+ txtSenha<br/>+ btnEntrar<br/>+ lblErrors: Label<br/>+ ValidarLogin(): Task<br/>+ ExibirErros(List<ErrorDTO>)<br/>+ ExibirAlertas(List<WarningDTO>)"]
            
            MainForm["MainForm<br/>+ menuStrip<br/>+ statusStrip<br/>+ lblNotificacoes: Label<br/>+ AbrirTela()<br/>+ ExibirNotificacoes(NotificationResult)"]
            
            ProjetoForm["ProjetoForm<br/>+ txtCodigo<br/>+ txtNome<br/>+ cmbModulo<br/>+ dtpInicio<br/>+ dtpFim<br/>+ pnlErrors: Panel<br/>+ SalvarProjeto(): Task<br/>+ ExibirErros(List<ErrorDTO>)<br/>+ ExibirAlertas(List<WarningDTO>)<br/>+ ValidarCampos(): NotificationResult"]
            
            AtividadeForm["AtividadeForm<br/>+ txtCodigo<br/>+ txtNome<br/>+ cmbProjeto<br/>+ cmbResponsavel<br/>+ pnlErrors: Panel<br/>+ SalvarAtividade(): Task<br/>+ ExibirErros(List<ErrorDTO>)<br/>+ ExibirAlertas(List<WarningDTO>)<br/>+ ValidarCampos(): NotificationResult"]
            
