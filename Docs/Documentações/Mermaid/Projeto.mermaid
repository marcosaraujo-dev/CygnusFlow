
graph TB
    subgraph "🎯 DOMAIN LAYER"
        subgraph "Entities"
            Usuario["👤 Usuario<br/>- Id: int<br/>- Nome: string<br/>- Email: string<br/>- SenhaHash: string<br/>- EquipeId: int?<br/>- TipoUsuarioId: int<br/>- StatusUsuarioId: int<br/>- BloqueadoPorRedefinicao: bool<br/>- DataCadastro: DateTime<br/>+ Validate(): NotificationResult"]
            
            Projeto["📁 Projeto<br/>- Id: int<br/>- Codigo: string<br/>- Nome: string<br/>- ModuloId: int<br/>- CriticidadeId: int<br/>- DataInicioPO: DateTime<br/>- DataFimPO: DateTime<br/>- EstimativaHoras: int<br/>- StatusProjetoId: int<br/>- DataCadastro: DateTime<br/>+ Validate(): NotificationResult<br/>+ ValidarPrazos(): NotificationResult"]
            
            Atividade["📋 Atividade<br/>- Id: int<br/>- Codigo: string<br/>- Nome: string<br/>- ProjetoId: int<br/>- ResponsavelId: int<br/>- TipoAtividadeId: int<br/>- DataInicioEstimada: DateTime<br/>- DataFimEstimada: DateTime<br/>- DataInicioPlanejada: DateTime?<br/>- DataFimPlanejada: DateTime?<br/>- DataInicioReal: DateTime?<br/>- DataFimReal: DateTime?<br/>- StatusProjetoId: int<br/>- Observacoes: string<br/>- Impedimentos: string<br/>+ Validate(): NotificationResult<br/>+ ValidarDatas(): NotificationResult"]
        end
        
        subgraph "Value Objects"
            CodigoProjeto["CodigoProjeto<br/>- Value: string<br/>+ Create(string): Result<CodigoProjeto><br/>+ GerarProximoCodigo(): Result<CodigoProjeto><br/>+ Validate(): NotificationResult"]
            
            CodigoAtividade["CodigoAtividade<br/>- Value: string<br/>+ Create(string): Result<CodigoAtividade><br/>+ GerarProximoCodigo(): Result<CodigoAtividade><br/>+ Validate(): NotificationResult"]
            
            PeriodoProjeto["PeriodoProjeto<br/>- DataInicio: DateTime<br/>- DataFim: DateTime<br/>+ Create(DateTime, DateTime): Result<PeriodoProjeto><br/>+ ValidarCoerencia(): NotificationResult<br/>+ CalcularDuracao(): int"]
        end
        
        subgraph "Domain Services"
            ProjetoService["ProjetoService<br/>+ ValidarPrazos(Projeto): NotificationResult<br/>+ CalcularAtraso(Projeto): Result<TimeSpan><br/>+ VerificarConflitos(Projeto): NotificationResult"]
            
            UsuarioService["UsuarioService<br/>+ ValidarPermissoes(Usuario): NotificationResult<br/>+ GerarCodigoRedefinicao(): Result<string><br/>+ ValidarSenha(string): NotificationResult"]
        end
        
        subgraph "Notification Pattern"
            NotificationResult["NotificationResult<br/>- Errors: List<Error><br/>- Warnings: List<Warning><br/>+ IsValid: bool<br/>+ HasWarnings: bool<br/>+ AddError(string, string)<br/>+ AddWarning(string, string)<br/>+ Merge(NotificationResult)"]
            
            Error["Error<br/>- Field: string<br/>- Message: string<br/>- Code: string"]
            
            Warning["Warning<br/>- Field: string<br/>- Message: string<br/>- Code: string"]
        end
        
        subgraph "Result Pattern"
            Result["Result<T><br/>- Data: T<br/>- Notifications: NotificationResult<br/>+ IsSuccess: bool<br/>+ Create(T): Result<T><br/>+ Failure(NotificationResult): Result<T><br/>+ Success(T): Result<T>"]
            
            ResultList["ResultList<T><br/>- Items: List<T><br/>- TotalCount: int<br/>- Notifications: NotificationResult<br/>+ IsSuccess: bool<br/>+ Create(List<T>, int): ResultList<T>"]
        end
        
        subgraph "Repository Interfaces"
            IUsuarioRepository["IUsuarioRepository<br/>+ GetByIdAsync(int): Task<Result<Usuario>><br/>+ GetByEmailAsync(string): Task<Result<Usuario>><br/>+ CreateAsync(Usuario): Task<Result<Usuario>><br/>+ UpdateAsync(Usuario): Task<Result<Usuario>><br/>+ DeleteAsync(int): Task<Result<bool>><br/>+ GetAllAsync(): Task<ResultList<Usuario>>"]
            
            IProjetoRepository["IProjetoRepository<br/>+ GetByIdAsync(int): Task<Result<Projeto>><br/>+ GetByCodigoAsync(string): Task<Result<Projeto>><br/>+ GetByFiltrosAsync(filtros): Task<ResultList<Projeto>><br/>+ CreateAsync(Projeto): Task<Result<Projeto>><br/>+ UpdateAsync(Projeto): Task<Result<Projeto>>"]
            
            IAtividadeRepository["IAtividadeRepository<br/>+ GetByIdAsync(int): Task<Result<Atividade>><br/>+ GetByProjetoIdAsync(int): Task<ResultList<Atividade>><br/>+ GetByResponsavelAsync(int): Task<ResultList<Atividade>><br/>+ CreateAsync(Atividade): Task<Result<Atividade>><br/>+ UpdateAsync(Atividade): Task<Result<Atividade>>"]
        end

        subgraph "Constants & Error Codes - MVP 1"
            ErrorCodes["ErrorCodes<br/>+ REQUIRED: string<br/>+ INVALID_FORMAT: string<br/>+ MIN_LENGTH: string<br/>+ MAX_LENGTH: string<br/>+ NOT_FOUND: string<br/>+ ALREADY_EXISTS: string<br/>+ UNAUTHORIZED: string<br/>+ FORBIDDEN: string<br/>+ PROJETO_CODIGO_DUPLICADO: string<br/>+ PROJETO_DATAS_INVALIDAS: string<br/>+ ATIVIDADE_FORA_PERIODO_PROJETO: string<br/>+ USUARIO_INATIVO: string"]
            
            ErrorMessages["ErrorMessages<br/>- Messages: Dictionary<string, string><br/>+ GetMessage(string): string"]
        end
    end
    
    subgraph "🔧 APPLICATION LAYER"
