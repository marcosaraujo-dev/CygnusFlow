        end
        
        subgraph "DTOs"
            UsuarioDTO["UsuarioDTO<br/>• CreateUsuarioDTO<br/>• UpdateUsuarioDTO<br/>• UsuarioResponseDTO<br/>• UsuarioListDTO<br/>• LoginDTO<br/>• LoginResponseDTO<br/>• RedefinirSenhaDTO"]
            
            ProjetoDTO["ProjetoDTO<br/>• CreateProjetoDTO<br/>• UpdateProjetoDTO<br/>• ProjetoResponseDTO<br/>• ProjetoListDTO<br/>• ProjetoDetalhesDTO<br/>• ProjetoFiltroDTO"]
            
            AtividadeDTO["AtividadeDTO<br/>• CreateAtividadeDTO<br/>• UpdateAtividadeDTO<br/>• AtividadeResponseDTO<br/>• AtividadeListDTO<br/>• AtividadeFiltroDTO"]
            
            ApiResponse["ApiResponse<T><br/>- Data: T<br/>- Errors: List<ErrorDTO><br/>- Warnings: List<WarningDTO><br/>- IsSuccess: bool<br/>- Message: string<br/>+ FromResult(Result<T>): ApiResponse<T>"]
        end
        
        subgraph "Services"
            AuthService["AuthService<br/>+ ValidarLogin(LoginDTO): Task<Result<LoginResponseDTO>><br/>+ GerarToken(Usuario): Result<string><br/>+ ValidarToken(string): Result<Usuario>"]
            
