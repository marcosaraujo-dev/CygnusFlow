            UsuarioUseCases["👤 Usuario Use Cases<br/>• CriarUsuarioUseCase: Task<Result<UsuarioResponseDTO>><br/>• EditarUsuarioUseCase: Task<Result<UsuarioResponseDTO>><br/>• RedefinirSenhaUseCase: Task<Result<bool>><br/>• LoginUseCase: Task<Result<LoginResponseDTO>><br/>• ListarUsuariosUseCase: Task<ResultList<UsuarioListDTO>>"]
            
            ProjetoUseCases["📁 Projeto Use Cases<br/>• CriarProjetoUseCase: Task<Result<ProjetoResponseDTO>><br/>• EditarProjetoUseCase: Task<Result<ProjetoResponseDTO>><br/>• ListarProjetosUseCase: Task<ResultList<ProjetoListDTO>><br/>• AdicionarComentarioUseCase: Task<Result<bool>><br/>• ObterDetalhesProjetoUseCase: Task<Result<ProjetoDetalhesDTO>>"]
            
