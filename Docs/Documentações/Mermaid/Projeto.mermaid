    subgraph "🌐 API LAYER"
        subgraph "Controllers"
            AuthController["AuthController<br/>+ Login(LoginDTO): Task<ApiResponse<LoginResponseDTO>><br/>+ RedefinirSenha(RedefinirSenhaDTO): Task<ApiResponse<bool>><br/>+ ValidarToken(): Task<ApiResponse<Usuario>>"]
            
            UsuarioController["UsuarioController<br/>+ Get(int): Task<ApiResponse<UsuarioResponseDTO>><br/>+ Post(CreateUsuarioDTO): Task<ApiResponse<UsuarioResponseDTO>><br/>+ Put(int, UpdateUsuarioDTO): Task<ApiResponse<UsuarioResponseDTO>><br/>+ Delete(int): Task<ApiResponse<bool>><br/>+ GetAll(): Task<ApiResponse<List<UsuarioListDTO>>>"]
            
            ProjetoController["ProjetoController<br/>+ Get(int): Task<ApiResponse<ProjetoResponseDTO>><br/>+ Post(CreateProjetoDTO): Task<ApiResponse<ProjetoResponseDTO>><br/>+ Put(int, UpdateProjetoDTO): Task<ApiResponse<ProjetoResponseDTO>><br/>+ GetByFiltros(ProjetoFiltroDTO): Task<ApiResponse<List<ProjetoListDTO>>><br/>+ AdicionarComentario(int, string): Task<ApiResponse<bool>>"]
            
            AtividadeController["AtividadeController<br/>+ Get(int): Task<ApiResponse<AtividadeResponseDTO>><br/>+ Post(CreateAtividadeDTO): Task<ApiResponse<AtividadeResponseDTO>><br/>+ Put(int, UpdateAtividadeDTO): Task<ApiResponse<AtividadeResponseDTO>><br/>+ GetByProjeto(int): Task<ApiResponse<List<AtividadeListDTO>>><br/>+ AdicionarComentario(int, string): Task<ApiResponse<bool>>"]
            
            RelatorioController["RelatorioController<br/>+ GerarGantt(filtros): Task<ApiResponse<GanttDataDTO>><br/>+ Dashboard(): Task<ApiResponse<DashboardDTO>><br/>+ ExportarPDF(filtros): Task<ApiResponse<FileDTO>>"]
        end
        
        subgraph "Middleware"
            AuthMiddleware["AuthMiddleware<br/>+ InvokeAsync(HttpContext): Task<br/>+ ValidateJWT(): Result<ClaimsPrincipal>"]
            
            ExceptionMiddleware["ExceptionMiddleware<br/>+ InvokeAsync(HttpContext): Task<br/>+ HandleException(Exception): ApiResponse<object>"]
            
            NotificationMiddleware["NotificationMiddleware<br/>+ InvokeAsync(HttpContext): Task<br/>+ ProcessNotifications(): ApiResponse<object>"]
        end
        
        subgraph "Filters"
            AuthorizeFilter["AuthorizeFilter<br/>+ OnAuthorization(AuthorizationFilterContext)<br/>+ ValidatePermissions(): NotificationResult"]
            
            ValidationFilter["ValidationFilter<br/>+ OnActionExecuting(ActionExecutingContext)<br/>+ ValidateModel(): NotificationResult"]
        end
    end
    
    subgraph "🖥️ WINFORMS LAYER"
