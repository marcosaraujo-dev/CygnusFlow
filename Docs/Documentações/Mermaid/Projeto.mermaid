        end
    end
    
    subgraph "🏗️ INFRASTRUCTURE LAYER"
        subgraph "Data"
            AppDbContext["AppDbContext<br/>+ DbSet<Usuario><br/>+ DbSet<Projeto><br/>+ DbSet<Atividade><br/>+ DbSet<Equipe><br/>+ DbSet<StatusUsuario><br/>+ OnModelCreating()<br/>+ SaveChangesAsync(): Task<Result<int>>"]
            
